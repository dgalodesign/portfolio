---
import Page from '../../layouts/Page.astro';
import { t, tools, langs, type Lang } from '../../i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const d = t[lang];
---
<Page lang={lang} title={d.about.title} path="sobre-mi/">
  <section class="block">
    <div class="wrap prose">
      <h1 style="font-size: clamp(2.4rem, 7vw, 5rem); margin-bottom: 32px">{d.about.title}</h1>
      {d.about.body.map((p) => <p>{p}</p>)}
      <h2>{d.about.skills}</h2>
      <div class="chips">{tools.map((x) => <span>{x}</span>)}</div>
    </div>
  </section>
</Page>
