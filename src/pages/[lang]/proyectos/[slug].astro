---
import { getCollection, render } from 'astro:content';
import Page from '../../../layouts/Page.astro';
import { t, type Lang } from '../../../i18n';

export async function getStaticPaths() {
  const all = await getCollection('casos');
  return all.map((c) => ({
    params: { lang: c.data.lang, slug: c.id.split('/').pop() },
    props: { entry: c },
  }));
}
const lang = Astro.params.lang as Lang;
const { slug } = Astro.params;
const { entry } = Astro.props;
const d = t[lang];
const { Content } = await render(entry);
---
<Page lang={lang} title={entry.data.title} description={entry.data.summary} path={`proyectos/${slug}/`} noindex={entry.data.draft}>
  <article class="wrap" style="padding-block: 64px 96px">
    <a href={`/${lang}/#work`} class="btn-ghost">{d.case.back}</a>
    <header class="case-head">
      <h1>{entry.data.title}</h1>
      <p class="prose" style="color: var(--muted); font-size: 1.2rem">{entry.data.summary}</p>
      <dl class="facts">
        <div><dt>{d.case.role}</dt><dd>{entry.data.role}</dd></div>
        <div><dt>{d.case.year}</dt><dd>{entry.data.year}</dd></div>
        <div><dt>{d.case.team}</dt><dd>{entry.data.team}</dd></div>
      </dl>
      {entry.data.draft && <p class="note">{d.case.draftNote}</p>}
    </header>
    <div class="prose"><Content /></div>
  </article>
</Page>
